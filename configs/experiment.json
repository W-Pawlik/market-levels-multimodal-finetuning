{
  "source": "Binance Vision",
  "market": "spot",
  "symbols": [
    "BTCUSDT",
    "ETHUSDT"
  ],
  "interval": "4h",
  "history_start_month": "2020-01",
  "history_end_month": "2026-10",
  "download": {
    "output": "data",
    "offline": false,
    "strict_gaps": false,
    "daily_fallback": true
  },
  "candles_per_chart": 120,
  "train_stride_candles": 60,
  "validation_stride_candles": 120,
  "test_stride_candles": 120,
  "target_total_charts": 800,
  "target_real_share": 0.45,
  "target_synthetic_share": 0.55,
  "chart_width_px_initial": 1024,
  "chart_height_px_initial": 768,
  "notes": "Podzia? chronological_v1 i zbi?r 800 przyk?ad?w zatwierdzone. Dwa nowe profile V2-full-refined zatwierdzono decyzj? autora pracy z 2026-11-07; historyczne profile pozostaj? bez zmian. Model i hiperparametry wymagaj? osobnej decyzji.",
  "synthetic": {
    "$file": "synthetic/generation.json",
    "$section": "synthetic"
  },
  "chronological_split": {
    "$file": "data/chronological_split.json",
    "$section": "chronological_split"
  },
  "synthetic_v2": {
    "$file": "synthetic/generation.json",
    "$section": "synthetic_v2"
  },
  "synthetic_v2_calibration": {
    "$file": "synthetic/calibration.json",
    "$section": "synthetic_v2_calibration"
  },
  "volatility_refinement_v1": {
    "$file": "synthetic/refinement.json",
    "$section": "volatility_refinement_v1"
  },
  "dataset_build": {
    "$file": "datasets/build.json",
    "$section": "dataset_build"
  }
}
